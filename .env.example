# --- Model (pick one) -------------------------------------------------------
ANTHROPIC_API_KEY=
# ATLAS_PROVIDER=anthropic
# ATLAS_MODEL=claude-sonnet-5-5

# OpenAI or any OpenAI-compatible endpoint (Gemini, OpenRouter, Groq, local vLLM/Ollama):
# ATLAS_PROVIDER=openai
# OPENAI_API_KEY=
# ATLAS_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # e.g. Gemini
# ATLAS_MODEL=gemini-2.5-flash

# --- Runtime ------------------------------------------------------------------
# ATLAS_AUTONOMY=balanced        # strict | balanced | autonomous
# ATLAS_MAX_STEPS=60
# ATLAS_HEADLESS=1               # 0 to watch the browser
# ATLAS_RECORD_VIDEO=0           # 1 to save a video of every run (runs/<id>/video)
# ATLAS_PRICE_IN=3               # optional USD per million input tokens, for cost estimates
# ATLAS_PRICE_OUT=15

# --- Sandbox (fake credentials for the simulated company; never real ones) ---
# SANDBOX_URL=http://127.0.0.1:8800
# SANDBOX_ADMIN_TOKEN=dev-admin-token
